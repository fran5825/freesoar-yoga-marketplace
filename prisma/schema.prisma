generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String?                  @unique
  emailVerified           DateTime?
  image                   String?
  phone                   String?
  isAdmin                 Boolean                  @default(false)
  accounts                Account[]
  sessions                Session[]
  teacherProfile          TeacherProfile?
  organizerProfile        OrganizerProfile?
  enrollments             Enrollment[]
  seriesEnrollments       SeriesEnrollment[]
  notifications           Notification[]
  reviews                 Review[]
  // organizer-usability-redesign 票 05：確認過的合作邀請（確認者）
  confirmedClassProposals OrganizerClassProposal[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model TeacherProfile {
  id                            String               @id @default(cuid())
  userId                        String               @unique
  displayName                   String?
  bio                           String?
  teachingStyle                 String?
  experienceYears               Int?
  certifications                String[]             @default([])
  specialties                   String[]             @default([])
  serviceAreas                  String[]             @default([])
  teachingFormats               String[]             @default([])
  priceRange                    String?
  profilePhotoUrl               String?
  preferredSessionLengthMinutes Int?
  preferredFrequency            String?
  preferredLocationType         String?
  preferenceNotes               String?
  status                        TeacherProfileStatus @default(draft)
  rejectionReason               String?
  suspensionReason              String?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt

  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  demandResponses        DemandResponse[]
  classSessions          ClassSession[]
  teacherAvailabilities  TeacherAvailability[]
  availabilityExceptions AvailabilityException[]
  recurringClassSeries   RecurringClassSeries[]
  classProposals         OrganizerClassProposal[]
}

// teacher-availability D2/D11：不含原始草稿的 isRecurring 欄位——這個 model 本身就是
// 「固定、重複出現」的既有語意（跟 AvailabilityException 用不同 table 區分固定/例外），
// isRecurring 不管填什麼都不影響任何查詢或顯示邏輯，是多餘欄位。
model TeacherAvailability {
  id               String   @id @default(cuid())
  teacherProfileId String
  dayOfWeek        Int // 0（週日）–6（週六），對齊 JS Date.getDay() 慣例
  startTime        String // "HH:mm"，24 小時制，00:00–23:59
  endTime          String // "HH:mm"，24 小時制，必須嚴格大於 startTime（不支援跨夜區間）
  locationArea     String? // 選填，上限 100 字
  createdAt        DateTime @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
}

// teacher-availability D3：blocked 優先於 extra_available——同一天同一個時段如果兩種記錄
// 都存在，任何消費者都必須把這個時段判讀為「不可授課」。這只是文件層級的判讀規則，
// 本輪不做寫入時的衝突檢查或資料庫約束（見 D3）。
enum AvailabilityExceptionType {
  blocked
  extra_available
}

// teacher-availability D4：startTime/endTime 皆為選填，兩者皆 null 代表「整天」。
model AvailabilityException {
  id               String                    @id @default(cuid())
  teacherProfileId String
  date             DateTime                  @db.Date // 只存日期，不含時間，避免時區造成的日期偏移，見 date-format.ts
  startTime        String? // "HH:mm"，與 endTime 必須同時提供或同時不提供
  endTime          String? // "HH:mm"，必須嚴格大於 startTime
  type             AvailabilityExceptionType
  reason           String? // 選填，上限 500 字
  createdAt        DateTime                  @default(now())

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
  @@index([date])
}

model OrganizerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedOrganizations Organization[]           @relation("OrganizationOwner")
  demandRequests     DemandRequest[]
  classSessions      ClassSession[]
  classProposals     OrganizerClassProposal[]
}

model Organization {
  id                      String           @id @default(cuid())
  name                    String
  type                    OrganizationType
  contactName             String?
  contactEmail            String?
  contactPhone            String?
  // organizer-usability-redesign 票 02：擁有這個團體的團主；null＝找不到 owner 的歷史團體（只有 admin 看得到）
  ownerOrganizerProfileId String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  ownerOrganizerProfile OrganizerProfile?        @relation("OrganizationOwner", fields: [ownerOrganizerProfileId], references: [id], onDelete: SetNull)
  demandRequests        DemandRequest[]
  classSessions         ClassSession[]
  classProposals        OrganizerClassProposal[]

  @@index([ownerOrganizerProfileId])
}

model DemandRequest {
  id                   String              @id @default(cuid())
  organizerProfileId   String
  organizationId       String
  title                String?
  serviceType          String? // 主要類型＝serviceTypes 的第一個，課程建立時預設帶入；之後確認沒人依賴再移除
  serviceTypes         String[]            @default([]) // 2026-09-25 起服務類型可多選（最多 3 個）
  description          String?
  targetLevel          String?
  expectedParticipants Int?
  preferredAreas       String[]            @default([]) // 2026-09-21 起存一筆自由輸入的地址／場地名稱；舊資料可能是多個縣市
  isOnline             Boolean             @default(false) // 線上課程：勾選後 preferredAreas 改為選填
  preferredTimeSlots   String[]            @default([])
  preferredStartDate   DateTime?
  classLengthMinutes   Int?
  frequency            String?
  budgetRange          String?
  status               DemandRequestStatus @default(draft)
  rejectionReason      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organizerProfile OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  demandResponses  DemandResponse[]
  classSession     ClassSession?

  @@index([status])
  @@index([organizerProfileId])
}

model DemandResponse {
  id                String               @id @default(cuid())
  demandRequestId   String
  teacherProfileId  String
  message           String
  proposedTimeSlots String[]             @default([])
  proposedPrice     String?
  status            DemandResponseStatus @default(submitted)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  demandRequest  DemandRequest  @relation(fields: [demandRequestId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([demandRequestId, teacherProfileId])
  @@index([demandRequestId])
  @@index([teacherProfileId])
  @@index([status])
}

// teacher-initiated-open-classes：origin 明確標記課程來源（organizer 媒合 vs 老師自建），
// 不靠 demandRequestId/organizerProfileId/organizationId 是否為 null 隱含推導——應用層不變量：
// origin = organizer_matched 時三者必須同時非 null；origin = teacher_initiated 時三者必須同時
// 是 null。此不變量只由兩條建課路徑各自的核心函式保證，不做資料庫層防呆。
enum ClassSessionOrigin {
  organizer_matched
  teacher_initiated
  // organizer-usability-redesign 票 09：團主邀請已合作的老師、老師確認後直接開團（沒有需求，有 converted 的合作邀請）
  organizer_direct
}

// teacher-initiated-open-classes G1 = A：常規／固定期課程的「範本」，實際可報名的單位仍是
// 下面 ClassSession 的逐筆記錄（materialize，不做動態展開）。dayOfWeek 只在「每週固定」模式
// 使用；固定期課程（例如連續 4 週的特定日期組合）由 Builder 在生成時直接寫入每筆
// ClassSession 的 startAt/endAt，series 本身不需要記錄每一個具體日期。
model RecurringClassSeries {
  id                 String                   @id @default(cuid())
  teacherProfileId   String
  title              String
  description        String?
  suitableFor        String? // 2026-10-06 member-flow 票 04：適合對象，系列預設值，生成場次時複製到每一場；最多 500 字（應用層限制）
  preparationNotes   String? // 2026-10-06 member-flow 票 04：準備事項，規則同 suitableFor
  serviceType        String? // 主要課程風格＝serviceTypes 的第一個（公開篩選與舊資料相容用）
  serviceTypes       String[]                 @default([]) // 2026-09-26 課程風格可多選（最多 3 個），沿用需求 serviceTypes 的做法
  yogaStyles         String[]                 @default([]) // 2026-09-26 瑜伽風格（老師建課必填，可多選＋自訂），來源同老師「擅長類型」標籤
  dayOfWeek          Int? // 0（週日）–6，對齊既有 TeacherAvailability 慣例；固定期課程可為 null
  startTime          String // "HH:mm"
  endTime            String // "HH:mm"
  location           String
  capacity           Int
  requiresApproval   Boolean                  @default(false)
  isPublic           Boolean                  @default(false) // teacher-class-scheduling 票 06：系列的公開設定，生成與追加的場次沿用；既有系列為 false（僅透過連結招募）
  // teacher-class-scheduling 票 07：系列型態與期班報名方式，建立後不能改（推導規則 7）。
  // DB check：continuous 時 termEnrollmentMode 必為 NULL；term 時必有值。
  kind               RecurringClassSeriesKind @default(continuous)
  termEnrollmentMode TermEnrollmentMode?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  teacherProfile    TeacherProfile     @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classSessions     ClassSession[]
  seriesEnrollments SeriesEnrollment[]

  @@index([teacherProfileId])
}

// teacher-class-scheduling 票 08（ADR 0005）：整期報名紀錄。每一場仍是各自的 Enrollment，
// 屬於整期的那幾筆用 Enrollment.seriesEnrollmentId 指回這裡。
// 同一位學員對同一期班只能有一筆（含已退出，推導規則 5）。
model SeriesEnrollment {
  id                     String                 @id @default(cuid())
  recurringClassSeriesId String
  userId                 String
  status                 SeriesEnrollmentStatus
  notes                  String?
  consentedAt            DateTime
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  recurringClassSeries RecurringClassSeries @relation(fields: [recurringClassSeriesId], references: [id], onDelete: Cascade)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments          Enrollment[]

  @@unique([recurringClassSeriesId, userId])
  @@index([userId])
}

// pending：需確認的期班等老師確認；confirmed：成立；declined：老師婉拒（票 10）；withdrawn：學員退出整期（票 09）。
enum SeriesEnrollmentStatus {
  pending
  confirmed
  declined
  withdrawn
}

// 屬於整期報名的每一場報名，記錄它是報整期時新增的，還是報整期前就存在、被併入的單堂報名
// （推導規則 9：整期被婉拒時，前者取消、後者脫離整期恢復為單堂）。
enum SeriesEnrollmentSource {
  term_created
  merged_single
}

// teacher-class-scheduling 票 07：持續開課（可一直生成更多）／期班（堂數建立時固定）。
enum RecurringClassSeriesKind {
  continuous
  term
}

// teacher-class-scheduling 票 07：期班的報名方式，只有 kind = term 時有值。
enum TermEnrollmentMode {
  term_only
  term_and_single
}

model ClassSession {
  id                     String             @id @default(cuid())
  demandRequestId        String?            @unique // teacher-initiated-open-classes：改為 nullable；Postgres 唯一索引允許多筆 NULL，既有「一個 demand 最多一個 class」語意不受影響
  teacherProfileId       String // 不變：一律必填，任何來源的課程都一定有授課老師
  organizerProfileId     String? // teacher-initiated-open-classes：改為 nullable
  organizationId         String? // teacher-initiated-open-classes：改為 nullable
  origin                 ClassSessionOrigin @default(organizer_matched)
  recurringClassSeriesId String?
  requiresApproval       Boolean            @default(false)
  title                  String
  description            String?
  suitableFor            String? // 2026-10-05 member-flow 票 03：適合對象／程度，老師選填，最多 500 字（應用層限制）
  preparationNotes       String? // 2026-10-05 member-flow 票 03：準備事項，老師選填，最多 500 字（應用層限制）
  serviceType            String? // 主要課程風格＝serviceTypes 的第一個
  serviceTypes           String[]           @default([]) // 2026-09-26 課程風格可多選（最多 3 個）
  yogaStyles             String[]           @default([]) // 2026-09-26 瑜伽風格；老師建立的課必填，團主媒合的課為空
  startAt                DateTime
  endAt                  DateTime
  location               String
  capacity               Int
  isPublic               Boolean            @default(false)
  status                 ClassSessionStatus @default(draft)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  demandRequest          DemandRequest?          @relation(fields: [demandRequestId], references: [id], onDelete: Restrict)
  teacherProfile         TeacherProfile          @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  organizerProfile       OrganizerProfile?       @relation(fields: [organizerProfileId], references: [id], onDelete: Restrict)
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recurringClassSeries   RecurringClassSeries?   @relation(fields: [recurringClassSeriesId], references: [id], onDelete: SetNull)
  enrollments            Enrollment[]
  reviews                Review[]
  // organizer-usability-redesign：直接開團（organizer_direct，票 09）由這筆合作邀請轉成
  organizerClassProposal OrganizerClassProposal?

  @@index([teacherProfileId])
  @@index([organizerProfileId])
  @@index([status])
  @@index([recurringClassSeriesId])
  @@index([origin])
}

// organizer-usability-redesign 票 05（spec 13.2）：團主對平台已審核老師提出的單堂合作邀請，
// 也保存直接開團的草稿。老師確認前不建立正式課程；只有 confirmed 且尚未轉課的邀請占用老師時段。
enum OrganizerClassProposalStatus {
  draft
  pending_confirmation
  confirmed
  declined
  withdrawn
  converted
}

model OrganizerClassProposal {
  id                 String                       @id @default(cuid())
  organizerProfileId String // owner，server 從登入者解析
  organizationId     String // 必須是 owner 自己的團體；送出後（submittedAt 不為 null）不可改
  teacherProfileId   String? // 草稿可以還沒選老師
  title              String?
  description        String?
  serviceType        String? // 主要課程風格＝serviceTypes 第一個
  serviceTypes       String[]                     @default([])
  yogaStyles         String[]                     @default([])
  startAt            DateTime?
  endAt              DateTime?
  location           String?
  capacity           Int?
  isPublic           Boolean                      @default(false) // 預設僅透過連結招募
  status             OrganizerClassProposalStatus @default(draft)
  version            Int                          @default(1) // 內容每次存檔 +1，老師確認時必須符合
  transitionSeq      Int                          @default(0) // 每次成功寫入 +1，供通知去重（spec 13.7）
  declineReason      String?
  withdrawReason     String?
  submittedAt        DateTime? // 第一次送出時寫入、之後不清空
  confirmedVersion   Int?
  confirmedAt        DateTime?
  confirmedByUserId  String?
  classSessionId     String?                      @unique // converted 後指向正式課程
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organizerProfile OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teacherProfile   TeacherProfile?  @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  confirmedByUser  User?            @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  classSession     ClassSession?    @relation(fields: [classSessionId], references: [id], onDelete: Restrict)

  @@index([organizerProfileId])
  @@index([teacherProfileId, status])
  @@index([status])
}

model Enrollment {
  id                     String                  @id @default(cuid())
  classSessionId         String
  userId                 String
  status                 EnrollmentStatus        @default(confirmed)
  notes                  String?
  consentedAt            DateTime
  // 票 08：屬於整期報名時指向它，並記錄來源；單堂報名兩者皆為 NULL（DB check：同為 NULL 或同有值）。
  seriesEnrollmentId     String?
  seriesEnrollmentSource SeriesEnrollmentSource?
  // enrollment-re-enrollment 票 01：這筆報名是誰取消的（ADR 0006）。只有 status = cancelled 時有值，
  // 離開 cancelled 時清為 NULL（DB check）；舊資料為 NULL，顯示「原因未記錄」且不能重新報名。
  cancelledBy            EnrollmentCancelledBy?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  classSession     ClassSession      @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesEnrollment SeriesEnrollment? @relation(fields: [seriesEnrollmentId], references: [id], onDelete: SetNull)

  @@unique([classSessionId, userId])
  @@index([seriesEnrollmentId])
  @@index([classSessionId])
  @@index([userId])
  @@index([status])
}

// D2/D4（class-session-review-plan）：不含 teacherProfileId（授課老師一律透過
// classSession 關聯取得，避免沒有 DB 一致性保證的冗餘欄位）與 visibility（V1 沒有任何
// 公開頁面可以消費這個欄位）。
model Review {
  id             String   @id @default(cuid())
  classSessionId String
  reviewerUserId String
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  reviewer     User         @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, reviewerUserId])
  @@index([classSessionId])
}

model Notification {
  id         String                  @id @default(cuid())
  userId     String
  type       NotificationType
  channel    NotificationChannel
  title      String
  body       String
  status     NotificationStatus      @default(pending)
  createdAt  DateTime                @default(now())
  sentAt     DateTime?
  // organizer-usability-redesign 票 12（spec 13.7，產品主人 2026-10-05 確認方案 A）：
  // targetType＋targetId 讓通知直達單筆（連結由 server 依白名單推導，不存網址）；
  // eventKey 防止同一事件重試時重複發送（邀請 id＋transitionSeq＋收件人）。舊通知三欄皆為空。
  targetType NotificationTargetType?
  targetId   String?
  eventKey   String?                 @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum TeacherProfileStatus {
  draft
  submitted
  approved
  rejected
  suspended
}

enum OrganizationType {
  company
  company_club
  community
  family_group
  other
}

enum DemandRequestStatus {
  draft
  submitted
  under_review
  published
  teacher_responded
  matched
  converted_to_class
  completed
  cancelled
  expired
  rejected
}

enum DemandResponseStatus {
  submitted
  shortlisted
  selected
  declined
  withdrawn
  expired
}

enum ClassSessionStatus {
  draft
  pending_confirmation
  open_for_enrollment
  confirmed
  completed
  cancelled
}

// enrollment-re-enrollment 票 01：取消者。member＝學員自己取消或請假；teacher＝老師婉拒；admin＝管理員取消；
// system＝整堂課被取消、學員退出整期、整期被婉拒時已終結的請假報名等連帶取消。
enum EnrollmentCancelledBy {
  member
  teacher
  admin
  system
}

enum EnrollmentStatus {
  pending
  confirmed
  cancelled
  attended
  no_show
}

enum NotificationType {
  teacher_application_submitted
  teacher_application_approved
  teacher_application_rejected
  teacher_profile_suspended
  teacher_profile_restored
  demand_request_submitted
  demand_request_published
  demand_request_rejected
  demand_request_cancelled
  demand_response_submitted
  demand_response_selected
  class_session_created
  class_session_changed
  class_session_cancelled
  class_session_completed
  enrollment_confirmed
  enrollment_pending_review
  enrollment_cancelled
  class_reminder_basic
  review_submitted
  // organizer-usability-redesign 票 12：合作邀請事件。
  class_proposal_invited
  class_proposal_confirmed
  class_proposal_declined
  class_proposal_withdrawn
  class_proposal_revised
}

// 通知可直達的單筆頁白名單（organizer-usability-redesign 票 12）。
enum NotificationTargetType {
  organizer_class_proposal
  teacher_class_proposal
  organizer_class_session
  teacher_class_session
}

enum NotificationChannel {
  email
  in_app
  line
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
  cancelled
}
