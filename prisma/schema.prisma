generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  phone            String?
  isAdmin          Boolean           @default(false)
  accounts         Account[]
  sessions         Session[]
  teacherProfile   TeacherProfile?
  organizerProfile OrganizerProfile?
  enrollments      Enrollment[]
  notifications    Notification[]
  reviews          Review[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model TeacherProfile {
  id              String               @id @default(cuid())
  userId          String               @unique
  displayName     String?
  bio             String?
  teachingStyle   String?
  experienceYears Int?
  certifications  String[]             @default([])
  specialties     String[]             @default([])
  serviceAreas    String[]             @default([])
  teachingFormats String[]             @default([])
  priceRange      String?
  profilePhotoUrl String?
  status          TeacherProfileStatus @default(draft)
  rejectionReason String?
  suspensionReason String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  demandResponses DemandResponse[]
  classSessions   ClassSession[]
}

model OrganizerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String?
  displayName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  demandRequests DemandRequest[]
  classSessions  ClassSession[]
}

model Organization {
  id           String           @id @default(cuid())
  name         String
  type         OrganizationType
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  organizerProfiles OrganizerProfile[]
  demandRequests    DemandRequest[]
  classSessions     ClassSession[]
}

model DemandRequest {
  id                   String              @id @default(cuid())
  organizerProfileId   String
  organizationId       String
  title                String?
  serviceType          String?
  description          String?
  targetLevel          String?
  expectedParticipants Int?
  preferredAreas       String[]            @default([])
  preferredTimeSlots   String[]            @default([])
  preferredStartDate   DateTime?
  classLengthMinutes   Int?
  frequency            String?
  budgetRange          String?
  status               DemandRequestStatus @default(draft)
  rejectionReason      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organizerProfile OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  demandResponses  DemandResponse[]
  classSession     ClassSession?

  @@index([status])
  @@index([organizerProfileId])
}

model DemandResponse {
  id                String               @id @default(cuid())
  demandRequestId   String
  teacherProfileId  String
  message           String
  proposedTimeSlots String[]             @default([])
  proposedPrice     String?
  status            DemandResponseStatus @default(submitted)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  demandRequest  DemandRequest  @relation(fields: [demandRequestId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([demandRequestId, teacherProfileId])
  @@index([demandRequestId])
  @@index([teacherProfileId])
  @@index([status])
}

model ClassSession {
  id                 String             @id @default(cuid())
  demandRequestId    String             @unique
  teacherProfileId   String
  organizerProfileId String
  organizationId     String
  title              String
  description        String?
  serviceType        String?
  startAt            DateTime
  endAt              DateTime
  location           String
  capacity           Int
  isPublic           Boolean            @default(false)
  status             ClassSessionStatus @default(draft)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  demandRequest    DemandRequest    @relation(fields: [demandRequestId], references: [id], onDelete: Restrict)
  teacherProfile   TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  organizerProfile OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Restrict)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enrollments      Enrollment[]
  reviews          Review[]

  @@index([teacherProfileId])
  @@index([organizerProfileId])
  @@index([status])
}

model Enrollment {
  id             String           @id @default(cuid())
  classSessionId String
  userId         String
  status         EnrollmentStatus @default(confirmed)
  notes          String?
  consentedAt    DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, userId])
  @@index([classSessionId])
  @@index([userId])
  @@index([status])
}

// D2/D4（class-session-review-plan）：不含 teacherProfileId（授課老師一律透過
// classSession 關聯取得，避免沒有 DB 一致性保證的冗餘欄位）與 visibility（V1 沒有任何
// 公開頁面可以消費這個欄位）。
model Review {
  id             String   @id @default(cuid())
  classSessionId String
  reviewerUserId String
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  reviewer     User         @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, reviewerUserId])
  @@index([classSessionId])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      NotificationType
  channel   NotificationChannel
  title     String
  body      String
  status    NotificationStatus   @default(pending)
  createdAt DateTime             @default(now())
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum TeacherProfileStatus {
  draft
  submitted
  approved
  rejected
  suspended
}

enum OrganizationType {
  company
  company_club
  community
  family_group
  other
}

enum DemandRequestStatus {
  draft
  submitted
  under_review
  published
  teacher_responded
  matched
  converted_to_class
  completed
  cancelled
  expired
  rejected
}

enum DemandResponseStatus {
  submitted
  shortlisted
  selected
  declined
  withdrawn
  expired
}

enum ClassSessionStatus {
  draft
  pending_confirmation
  open_for_enrollment
  confirmed
  completed
  cancelled
}

enum EnrollmentStatus {
  pending
  confirmed
  cancelled
  attended
  no_show
}

enum NotificationType {
  teacher_application_submitted
  teacher_application_approved
  teacher_application_rejected
  teacher_profile_suspended
  teacher_profile_restored
  demand_request_submitted
  demand_request_published
  demand_request_rejected
  demand_request_cancelled
  demand_response_submitted
  demand_response_selected
  class_session_created
  class_session_changed
  class_session_cancelled
  class_session_completed
  enrollment_confirmed
  enrollment_cancelled
  class_reminder_basic
  review_submitted
}

enum NotificationChannel {
  email
  in_app
  line
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
  cancelled
}
