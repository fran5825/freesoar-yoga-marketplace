generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String?           @unique
  emailVerified  DateTime?
  image          String?
  phone          String?
  isAdmin        Boolean           @default(false)
  accounts       Account[]
  sessions       Session[]
  teacherProfile TeacherProfile?
  organizerProfile OrganizerProfile?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model TeacherProfile {
  id              String               @id @default(cuid())
  userId          String               @unique
  displayName     String?
  bio             String?
  teachingStyle   String?
  experienceYears Int?
  certifications  String[]             @default([])
  specialties     String[]             @default([])
  serviceAreas    String[]             @default([])
  teachingFormats String[]             @default([])
  priceRange      String?
  profilePhotoUrl String?
  status          TeacherProfileStatus @default(draft)
  rejectionReason String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  demandResponses DemandResponse[]
}

model OrganizerProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  organizationId String?
  displayName    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  demandRequests DemandRequest[]
}

model Organization {
  id           String             @id @default(cuid())
  name         String
  type         OrganizationType
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  organizerProfiles OrganizerProfile[]
  demandRequests    DemandRequest[]
}

model DemandRequest {
  id                    String              @id @default(cuid())
  organizerProfileId    String
  organizationId        String
  title                 String?
  serviceType           String?
  description           String?
  targetLevel           String?
  expectedParticipants  Int?
  preferredAreas        String[]            @default([])
  preferredTimeSlots    String[]            @default([])
  preferredStartDate    DateTime?
  classLengthMinutes    Int?
  frequency             String?
  budgetRange           String?
  status                DemandRequestStatus @default(draft)
  rejectionReason       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organizerProfile OrganizerProfile @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  demandResponses  DemandResponse[]

  @@index([status])
  @@index([organizerProfileId])
}

model DemandResponse {
  id                String               @id @default(cuid())
  demandRequestId   String
  teacherProfileId  String
  message           String
  proposedTimeSlots String[]             @default([])
  proposedPrice     String?
  status            DemandResponseStatus @default(submitted)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  demandRequest  DemandRequest  @relation(fields: [demandRequestId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([demandRequestId, teacherProfileId])
  @@index([demandRequestId])
  @@index([teacherProfileId])
  @@index([status])
}

enum TeacherProfileStatus {
  draft
  submitted
  approved
  rejected
  suspended
}

enum OrganizationType {
  company
  company_club
  community
  family_group
  other
}

enum DemandRequestStatus {
  draft
  submitted
  under_review
  published
  teacher_responded
  matched
  converted_to_class
  completed
  cancelled
  expired
  rejected
}

enum DemandResponseStatus {
  submitted
  shortlisted
  selected
  declined
  withdrawn
  expired
}
