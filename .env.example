DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freesoar_yoga_marketplace_dev?schema=public"

AUTH_SECRET="replace-with-local-dev-secret"
AUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email 通知（Resend）。預設 disabled：只發站內通知，不寄信。
# - disabled：不寄信（本機、CI 預設）
# - allowlist：只寄給 EMAIL_ALLOWED_RECIPIENTS 裡的信箱（逗號分隔），實測用
# - live：寄給所有收件人；APP_BASE_URL 必須是 https、不可是 localhost
# 任何必要設定缺漏時一律不寄，站內通知照常。
EMAIL_DELIVERY_MODE="disabled"
RESEND_API_KEY=""
# 寄件人，地址的網域要先在 Resend 驗證，例如 飛索 <notifications@你的網域>
EMAIL_FROM=""
EMAIL_ALLOWED_RECIPIENTS=""
# 每封信等 Resend 回應的上限（毫秒，1000–10000，預設 5000）
EMAIL_TRANSPORT_TIMEOUT_MS=""

# Future optional providers. Not enabled in initialization stage.
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# 照片儲存（teacher-showcase-photos，ADR 0007）。預設不設定＝照片功能關閉，其他功能照常運作。
# - r2：正式環境，檔案放在 Cloudflare R2（需要下面五個值）。金鑰只放在 .env，不貼在對話、不進 Git。
# - local：只給本機開發與測試，檔案存在 LOCAL_STORAGE_DIR（預設 .local-storage）；正式環境不要用。
STORAGE_DRIVER=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# 照片公開網址的開頭（R2 bucket 的公開網域，或綁定的自訂網域），不含結尾斜線
R2_PUBLIC_BASE_URL=""
LOCAL_STORAGE_DIR=""
